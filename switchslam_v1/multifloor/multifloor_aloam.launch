<launch>
    <param name="scan_line" type="int" value="16" />
    <param name="mapping_skip_frame" type="int" value="1" />
    <param name="minimum_range" type="double" value="0.3"/>
    <param name="mapping_line_resolution" type="double" value="0.2"/>
    <param name="mapping_plane_resolution" type="double" value="0.4"/>
    <node pkg="aloam_velodyne" type="ascanRegistration" name="mf_ascanRegistration" output="screen">
        <remap from="/velodyne_points" to="/multifloor/velodyne_points"/>
    </node>
    <node pkg="aloam_velodyne" type="alaserOdometry" name="mf_alaserOdometry" output="screen"/>
    <node pkg="aloam_velodyne" type="alaserMapping" name="mf_alaserMapping" output="screen">
        <remap from="/laser_odom_to_init" to="/switch_fused_pose"/>
    </node>
</launch>
