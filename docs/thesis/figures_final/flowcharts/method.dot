digraph G {
  graph [rankdir=TB, nodesep=0.35, ranksep=0.26, dpi=220, fontname="TeX Gyre Termes", splines=ortho, pad=0.15];
  node  [fontname="TeX Gyre Termes", fontsize=13, penwidth=1.3, color="#333333", style=filled, fillcolor="#ffffff", margin="0.14,0.06"];
  edge  [fontname="TeX Gyre Termes", fontsize=11.5, penwidth=1.2, color="#333333", arrowsize=0.75];
  start [label="Start", shape=box, style="rounded,filled", fillcolor="#e8eef7", width=1.3];
  lit   [label="Literature study: LiDAR degeneracy, visual-inertial\nodometry and switching-based LiDAR-visual-inertial fusion", shape=box, fillcolor="#f5f5f5"];
  plat  [label="Build the test platform: A-LOAM and VINS-Mono in ROS (Docker),\nfive recorded sequences and a Gazebo farm simulation", shape=box, fillcolor="#f5f5f5"];
  sw    [label="Baseline study: switching node with\n15 degeneracy-detection rules on Multi Floor", shape=box, fillcolor="#f5f5f5"];
  d1    [label="Does better\ndetection give a\nlower error?", shape=diamond, fillcolor="#fff4d6", margin="0.02,0.02"];
  ref   [label="Refine the\ndetection rule", shape=box, fillcolor="#f5f5f5"];
  des   [label="Design per-direction weighting: channels R and T\n(Schur complements) and the additional T channel\n(orientation tensor); fix the constants on Multi Floor", shape=box, fillcolor="#e9f5ec"];
  live  [label="Write the pass rule, then run a live\ntest of the current version", shape=box, fillcolor="#f5f5f5"];
  d2    [label="Pass rule\nmet?", shape=diamond, fillcolor="#fff4d6", margin="0.02,0.02"];
  diag  [label="Diagnose the failure from the logs and add\none safeguard (F21 to F24) or guess rule (F25 to F35)", shape=box, fillcolor="#fdeceb"];
  frz   [label="Freeze the final configuration (F35)", shape=box, fillcolor="#e9f5ec"];
  eval  [label="Live runs on six sequences; comparison with VINS-Mono alone,\nA-LOAM alone, earlier versions and published Switch-SLAM;\nstatistical tests", shape=box, fillcolor="#f5f5f5"];
  stop  [label="End", shape=box, style="rounded,filled", fillcolor="#e8eef7", width=1.3];
  start -> lit -> plat -> sw -> d1;
  d1 -> des [xlabel="No  "];
  d1 -> ref [xlabel="Yes"]; ref -> sw [constraint=false];
  {rank=same; d1; ref;}
  des -> live -> d2;
  d2 -> frz [xlabel="Yes  "];
  d2 -> diag [xlabel=" No"];
  diag -> live [constraint=false];
  {rank=same; d2; diag;}
  frz -> eval -> stop;
}
