# Multi Floor (SubT-MRS, legged robot). Same bags, GT, topics and replay rate as the stock A-LOAM run.
: "${BAGS_ROOT:=/media/${USER:-$(id -un)}/One Touch1/laptop_bags}"
for d in multifloor MultiFloor Multi_Floor multi_floor RosBag; do [ -z "${BAG_DIR:-}" ] && ls "$BAGS_ROOT/$d"/*.bag >/dev/null 2>&1 && BAG_DIR="$BAGS_ROOT/$d"; done
: "${BAG_DIR:=$BAGS_ROOT/multifloor}"
: "${GT:=$HOME/Downloads/SubT_MRS_Hawkins_Multi_Floor_LegRobot/ground_truth_path.csv}"
IMU_TOPIC=/cmu_sp1/imu/data
PACKETS_TOPIC=/cmu_sp1/velodyne_packets
POINTS_TOPIC=
EXTRINSICS=mf_extrinsics.yaml
: "${PLAY_RATE:=1.0}"
