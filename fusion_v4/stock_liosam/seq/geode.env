# GEODE device alpha, stairs_alpha (VLP-16 + Xsens MTi-30). Per-point time is negative, relative to scan end (docs/setup/DATASETS.md).
: "${BAGS_ROOT:=/media/${USER:-$(id -un)}/One Touch1/laptop_bags}"
: "${BAG_DIR:=$BAGS_ROOT/GEODE}"
: "${GT:=$BAGS_ROOT/GEODE/stairs_alpha.txt}"
IMU_TOPIC=/imu/data
PACKETS_TOPIC=
POINTS_TOPIC=/velodyne_points
EXTRINSICS=../../geode/geode_extrinsics.yaml
: "${PLAY_RATE:=0.5}"
