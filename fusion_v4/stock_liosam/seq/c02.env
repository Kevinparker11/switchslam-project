# Corridor02 (SubT-MRS RC1, wheeled RC). Slow replay as in every other run on this sequence.
: "${BAGS_ROOT:=/media/${USER:-$(id -un)}/One Touch1/laptop_bags}"
: "${BAG_DIR:=$BAGS_ROOT/Corridor02}"
