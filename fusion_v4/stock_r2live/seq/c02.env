# c02: topics, bag folder, ground truth, replay rate and LiDAR-IMU extrinsics are those of the stock LIO-SAM run (same file);
# the camera topic and the camera config (intrinsics + camera-IMU extrinsics) are added here.
source "$(dirname "${BASH_SOURCE[0]}")/../../stock_liosam/seq/c02.env"
CAM_CONFIG=configs/corridor2/corridor2_config.yaml
CAM_TOPIC=/camera_1/image_raw
CAM_COMPRESSED=0
