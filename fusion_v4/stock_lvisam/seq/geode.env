# geode: topics, bag folder, ground truth, replay rate and LiDAR-IMU extrinsics are those of the stock LIO-SAM run (same file);
# the camera topic and the camera config (intrinsics + camera-IMU extrinsics) are added here.
source "$(dirname "${BASH_SOURCE[0]}")/../../stock_liosam/seq/geode.env"
CAM_CONFIG=fusion_v4/geode/geode_config.yaml
CAM_TOPIC=/left_camera/image_raw
CAM_COMPRESSED=1
